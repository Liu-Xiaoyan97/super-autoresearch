+def _jsonl_files(path):
+    """Accept one JSONL file or a directory of ``*.jsonl`` shards."""
+    resolved = Path(path).expanduser()
+    if resolved.is_dir():
+        files = sorted(resolved.rglob("*.jsonl"))
+        if not files:
+            raise ValueError(f"No .jsonl files found under {resolved}")
+        return files
+    if resolved.suffix.lower() != ".jsonl":
+        raise ValueError(f"JSONL data must be a .jsonl file or a directory of .jsonl files: {resolved}")
+    return [resolved]
+
+
+def resolve_data_format(path, data_format):
+    """Resolve auto by path shape: JSONL dir/file vs Pile parquet dir/file."""
+    if data_format not in ("auto", "jsonl", "pile-parquet"):
+        raise ValueError("data_format must be auto, jsonl or pile-parquet")
+    if data_format != "auto":
+        return data_format
+    resolved = Path(path).expanduser()
+    if resolved.is_dir():
+        return "jsonl" if any(resolved.rglob("*.jsonl")) else "pile-parquet"
+    return "pile-parquet" if resolved.suffix.lower() == ".parquet" else "jsonl"
+
