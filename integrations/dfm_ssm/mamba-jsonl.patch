+def test_jsonl_directory_shards(tmp_path):
+    root = tmp_path / "train"
+    root.mkdir()
+    (root / "part-000.jsonl").write_text(json.dumps({"text": "ab"}) + "\n")
+    (root / "part-001.jsonl").write_text(json.dumps({"text": "cd"}) + "\n")
+    dataset = DFMTextDataset(root, Tokenizer(), max_length=8)
+    assert len(dataset) == 2
+    assert resolve_data_format(root, "auto") == "jsonl"
+    (root / "part-002.parquet").write_bytes(b"")
+    assert resolve_data_format(root, "auto") == "jsonl"
+
