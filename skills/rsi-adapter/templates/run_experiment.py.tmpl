#!/usr/bin/env python3
"""RSI benchmark adapter for @@PROBLEM_ID@@.

This adapter belongs to the target project, not to RSI core. It is invoked in
one candidate worktree and must write one JSON metric report.

Contract:
  python run_experiment.py --repo REPO --scope subset|full|ablation|rebuttal --out OUT

The scaffold's train/evaluate/parse_metrics functions are TODOs. Wire them to
the target project's real entrypoints before running a real experiment.
"""

from __future__ import annotations

import argparse
import json
import os
import shlex
import subprocess
import sys
import time
from pathlib import Path

PROBLEM_ID = @@PROBLEM_ID@@
SLUG = @@SLUG@@
ENV_PREFIX = @@ENV_PREFIX@@
METRICS = @@METRICS@@
SCOPES = @@SCOPES@@
DEFAULT_REPO = @@DEFAULT_REPO@@
EXPERIMENT_COMMAND = @@EXPERIMENT_COMMAND@@


def env_str(name: str, default: str = "") -> str:
    return os.environ.get(f"{ENV_PREFIX}_{name}", default)


def env_int(name: str, default: int) -> int:
    try:
        return int(os.environ.get(f"{ENV_PREFIX}_{name}", default))
    except (TypeError, ValueError):
        return default


def env_float(name: str, default: float) -> float:
    try:
        return float(os.environ.get(f"{ENV_PREFIX}_{name}", default))
    except (TypeError, ValueError):
        return default


def fail(out: Path, message: str) -> int:
    """Always leave a machine-readable failure report."""
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(
        json.dumps(
            {"metrics": {}, "status": "failed", "error": message},
            indent=2,
            sort_keys=True,
        )
        + "\n"
    )
    print(message, file=sys.stderr)
    return 1


def run(
    argv: list[str],
    cwd: Path,
    env: dict[str, str],
    timeout: float | None,
) -> subprocess.CompletedProcess:
    print("+", shlex.join(argv), flush=True)
    return subprocess.run(
        argv,
        cwd=str(cwd),
        env=env,
        timeout=timeout,
        capture_output=True,
        text=True,
    )


def tail(text: str, limit: int = 4000) -> str:
    return text[-limit:] if len(text) > limit else text


