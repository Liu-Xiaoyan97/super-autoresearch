# Copy this to container/.env and fill in the key (or run ./container/sync-credentials.sh).
OPENCODE_API_KEY=sk-...
PI_PROVIDER=opencode-go
PI_MODEL=deepseek-v4.1-flash
PI_REASONING_LEVEL=high
# The Kiri VM reaches the Mac proxy through host.docker.internal, not 127.0.0.1.
CONTAINER_HTTP_PROXY=http://host.docker.internal:7890
CONTAINER_HTTPS_PROXY=http://host.docker.internal:7890
CONTAINER_NO_PROXY=localhost,127.0.0.1,.local,host.kiri.internal
# Optional: SSH target for Problem.remote.host fallback.
RSI_REMOTE_HOST=user@gpu-node
